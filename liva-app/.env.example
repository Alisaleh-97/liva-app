# ── Required ───────────────────────────────────────────────────────────────
# Backend API URL — your computer's LAN IP for phone access (NOT localhost).
EXPO_PUBLIC_API_URL=http://192.168.8.7:3001

# Local preview fallback. Set false in preview/release builds so authentication
# never falls back to locally stored demo credentials.
EXPO_PUBLIC_DEMO_MODE=true

# ── Optional integrations (each activates when set) ────────────────────────

# Image uploads — sign up free at https://cloudinary.com (1 min)
# Create an unsigned upload preset in Settings → Upload → Add upload preset.
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=liva-unsigned

# Stripe (test mode): get keys at https://dashboard.stripe.com/test/apikeys
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.liva.app

# Supabase backend (free tier): create a project at https://supabase.com
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Sign-In: create OAuth credentials at https://console.cloud.google.com
# (Authorized redirect URI: https://auth.expo.io/@your-expo-username/liva-app)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=...apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com

# Apple Sign-In: create a Services ID at https://developer.apple.com
# EXPO_PUBLIC_APPLE_SERVICE_ID=com.liva.signin
