# Copy this file to `.env` and fill in real values before starting the server.

# ── Server basics ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Required: JWT signing secret ──────────────────────────────────────────
# 32+ char random string. Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-real-32-char-secret-please-do-not-ship-this

# ── CORS whitelist (comma-separated) ──────────────────────────────────────
# In production this MUST be your real domains. Never ship "*".
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000

# ── OpenAI — required for /api/ai/* routes ────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Database ─────────────────────────────────────────────────────────────
# SQLite for local dev (zero setup). Production: postgresql://user:pw@host/db
DATABASE_URL="file:./dev.db"

# ── Stripe (test mode) — required for /api/payments/* ─────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Email delivery for one-time password reset codes (https://resend.com)
# In development, when unset, the code is printed by the server and returned
# only to the local preview. Production responses never expose the code.
RESEND_API_KEY=re_...
EMAIL_FROM=hello@liva.app

# OAuth audiences used by the backend to verify tokens. Google can contain
# iOS, Android and Web client IDs separated by commas. Apple is your Services
# ID and/or native bundle identifier.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.liva.app

# ── Cloudinary (optional) — image upload host ─────────────────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# When unset, /api/upload writes files to server/uploads/ instead.
CLOUDINARY_URL=

# ── Supabase (optional server-side ops) ───────────────────────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
